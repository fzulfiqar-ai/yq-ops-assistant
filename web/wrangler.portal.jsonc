// The ops portal (+ salesman app, /c/{token}, /o/{token}) on Cloudflare Workers static assets,
// 20-Sep-2026 — see wrangler.market.jsonc for how this works. Serves web/dist (the default build).
// Deploy: python -m scripts.deploy_cf portal (builds first) or .github/workflows/cf-deploy.yml.
// `routes` with custom_domain attach the hostnames: wrangler creates the DNS records and the
// certificate in the zone (same account) on deploy.
{
  "name": "yq-bahrain-ops",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "ops.yqmarketplace.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "observability": { "enabled": false }
}
