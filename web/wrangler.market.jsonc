// The marketplace on Cloudflare (Workers static assets — what Cloudflare now calls Pages), 20-Sep-2026.
// No Worker code: the `assets` block serves web/dist-market as-is, so every request is a static-asset
// request (free and unlimited on the Free plan). `single-page-application` returns index.html with
// HTTP 200 for any path that is not a file (the same behaviour as the old Vercel rewrite); response
// headers come from public/_headers, copied into the build root by Vite.
// Deploy: python -m scripts.deploy_cf market (builds first) or .github/workflows/cf-deploy.yml.
// `routes` with custom_domain attach the hostnames: wrangler creates the DNS records and the
// certificate in the zone (same account) on deploy.
{
  "name": "yq-marketplace",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./dist-market",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "yqmarketplace.com", "custom_domain": true },
    { "pattern": "www.yqmarketplace.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "observability": { "enabled": false }
}
