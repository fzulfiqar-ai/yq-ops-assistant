{
  "ci": {
    "collect": {
      "settings": {
        "preset": "perf",
        "formFactor": "mobile",
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.7
          }
        ],
        "categories:accessibility": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2500
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 300
          }
        ],
        "cumulative-layout-shift": [
          "warn",
          {
            "maxNumericValue": 0.05
          }
        ],
        "resource-summary:script:size": [
          "warn",
          {
            "maxNumericValue": 184320
          }
        ],
        "resource-summary:stylesheet:size": [
          "warn",
          {
            "maxNumericValue": 35840
          }
        ],
        "resource-summary:font:size": [
          "warn",
          {
            "maxNumericValue": 97280
          }
        ],
        "interactive": [
          "warn",
          {
            "maxNumericValue": 3500
          }
        ]
      }
    }
  }
}
